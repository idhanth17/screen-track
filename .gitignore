# Rust / Cargo
/target
**/target
# Cargo.lock is committed (this is an application, not a library)

# Node / extension tooling (extension itself is plain JS, no build)
node_modules/
dist/
*.log

# Tauri
app/src-tauri/target/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local data / secrets
*.sqlite
*.sqlite-*
.env

# Chrome "Pack extension" artifacts (we load unpacked; never commit the private key)
extension.crx
extension.pem
*.crx
*.pem

# Bundled AI model weights (~87MB) — fetched via scripts/fetch-model.ps1, not committed.
# The small config.json + tokenizer.json ARE committed so only the weights need fetching.
app/src-tauri/resources/minilm/model.safetensors

# Updater signing keys — NEVER commit
.keys/
