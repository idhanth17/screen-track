{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screen Track",
  "version": "0.1.2",
  "identifier": "com.screentrack.desktop",
  "build": {
    "frontendDist": "../dashboard"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Screen Track",
        "width": 1040,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdEOTFGREQ1QTcyN0ZDMkMKUldRcy9DZW4xZjJSZlY3L0U2UlRRVFFnekFMV2tRazZRVzJidlkxbkZWMlFPelJ4aTE4SVdKQ0QK",
      "endpoints": [
        "https://github.com/idhanth17/screen-track/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "publisher": "Screen Track",
    "copyright": "© 2026 Screen Track",
    "category": "Productivity",
    "shortDescription": "Automatic, private screen-time tracker",
    "longDescription": "Screen Track records how you spend time on your computer and classifies it automatically — Work, Study, Entertainment and more — resolving YouTube per channel. Everything stays on your device.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/minilm/config.json": "minilm/config.json",
      "resources/minilm/tokenizer.json": "minilm/tokenizer.json",
      "resources/minilm/model.safetensors": "minilm/model.safetensors"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
